{
  "env": {
    "node": true,
    "jest": true,
    "es2024": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "plugins": ["jest"],
  "parserOptions": {
    "sourceType": "module",
    "ecmaVersion": 2024
  },
  "rules": {
    "no-console": ["warn", { "allow": ["log", "error"] }],
    "jest/no-disabled-tests": "warn",
    "jest/no-focused-tests": "error",
    "jest/no-identical-title": "error",
    "jest/valid-expect": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**/*.js"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
